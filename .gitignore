*.ipdb

# 実行時に生成されるもの
imgui.ini

# Photon のサンプルとドキュメント（libとヘッダーだけ使う）
/k2EngineLow/ExEngine/Photon/Demos/
/k2EngineLow/ExEngine/Photon/doc/

# Mixamo などの元データ（FBX）。ライセンス上、元ファイルを公開リポジトリで配ってはいけない
*.fbx
# Mixamo から落とした元データの置き場（FBX と、読み込み時に展開されるテクスチャ）
/Game/Assets/assets/

# 上の Debug/ に巻き込まれないように、仮のモデルと画像の置き場は Git に入れる
!/Game/Assets/modelData/debug/
!/Game/Assets/sprite/debug/
# デバッグマネージャーのコード（Game/debug）も同じ理由で入れる
!/Game/debug/
# Visual Studio が文字コードを変えて保存するときの一時フォルダ
enc_temp_folder/

# エフェクト（War FX など）。Asset Store の規約で、素材を取り出せる形では配れないので Git に入れない
# 元データは 05_Assets/02_OVERFLOW に置き、別の PC へは手でコピーする
/Game/Assets/effect/
